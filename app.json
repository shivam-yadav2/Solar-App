{
  "expo": {
    "name": "SolarOS",
    "slug": "solaros-mobile",
    "scheme": "solaros",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/branding/brand-app-icon-v3.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solaros.mobile",
      "buildNumber": "3",
      "icon": "./assets/branding/brand-app-icon-v3.png"
    },
    "android": {
      "package": "com.solaros.mobile",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#071426",
        "foregroundImage": "./assets/branding/brand-adaptive-foreground-v3.png",
        "monochromeImage": "./assets/branding/brand-adaptive-monochrome-v3.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/brand-app-icon-v3.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/branding/brand-adaptive-foreground-v3.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/branding/brand-adaptive-foreground-v3.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/brand-adaptive-monochrome-v3.png",
          "color": "#f59e0b",
          "defaultChannel": "default"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "SolarOS uses your photos to attach site pictures, receipts and documents.",
          "cameraPermission": "SolarOS uses the camera to take site photos, receipts and documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SolarOS records where you punch in and where site reports are made."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiBaseUrl": "https://solaros.voidlayer.in/api"
    }
  }
}
